{
    "name": "@axelar-network/axelar-local-dev-sui",
    "version": "3.0.0",
    "private": true,
    "main": "dist/index.js",
    "files": [
        "dist/",
        "!dist/types",
        "move",
        "!move/**/build"
    ],
    "scripts": {
        "build": "run-s build:ts",
        "build:ts": "rm -rf dist && tsc",
        "test": "jest --testMatch='**/*.spec.ts'",
        "test:e2e": "jest --testMatch='**/*.e2e.ts' --runInBand --detectOpenHandles --forceExit",
        "start": "ts-node scripts/start.ts",
        "prettier": "prettier --write 'src/**/*.ts'"
    },
    "author": "",
    "license": "ISC",
    "description": "Local Sui development environment for Axelar cross-chain examples",
    "dependencies": {
        "@axelar-network/axelar-cgp-sui": "^1.2.0",
        "@axelar-network/axelar-local-dev": "workspace:^",
        "@mysten/sui": "^1.3.0",
        "ethers": "^5.7.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^18.7.13",
        "jest": "^29.7.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^2.8.8",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1"
    }
}
